# Vertex AI / Gemini Enterprise Configuration
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_ENTERPRISE_INSTANCE=your-gemini-enterprise-instance-name
PROJECT_NUMBER=your-gcp-numeric-project-number
GEMINI_APP_LOCATION=global
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=global
AGENT_REGION=us-central1

# Zero-Hardcoding Agent & Tool Models
AGENT_MODEL_ID=gemini-3.5-flash
OMNI_MODEL_ID=gemini-omni-flash-preview

# GCS Storage for Video Artifacts
GCS_BUCKET_NAME=your-gcs-bucket-name
LOGS_BUCKET_NAME=your-gcs-bucket-name

# Telemetry Configuration
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
GOOGLE_CLOUD_PROJECT_NUMBER=your-gcp-numeric-project-number
